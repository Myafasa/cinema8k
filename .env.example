# Copy to .env on each node. Use the actual private IPs and strong unique passwords.
ROOT_DOMAIN=localhost
NODE1_IP=192.168.1.11
NODE2_IP=192.168.1.12
NODE3_IP=192.168.1.13

DATABASE_URL=postgresql://cinema_runtime:runtime-change-me@192.168.1.13:5432/cinema?schema=public
AUTH_SECRET=replace-with-at-least-32-random-bytes
TICKET_HMAC_SECRET=replace-with-a-different-32-byte-random-secret

POSTGRES_PASSWORD=postgres-change-me
APP_DB_PASSWORD=runtime-change-me
MIGRATOR_PASSWORD=migrator-change-me
BACKUP_DB_PASSWORD=backup-change-me
APP_IMAGE=cinema-app:local
