# Contoh lokal. Gunakan login cinema_runtime anggota role cinema_app, bukan owner/migrator.
DATABASE_URL="postgresql://cinema_runtime:change-me@localhost:5432/cinema?schema=public"
ROOT_DOMAIN="localhost"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
TICKET_HMAC_SECRET="replace-with-a-different-random-secret"
